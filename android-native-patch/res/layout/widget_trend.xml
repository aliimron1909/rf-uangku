<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trend_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/trend_title"
            android:fontFamily="sans-serif-medium"
            android:text="Pemasukan vs pengeluaran"
            android:textColor="@color/rfw_text_dim"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/trend_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/rfw_text"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/trend_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:adjustViewBounds="false"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/trend_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/rfw_text"
        android:textSize="13sp" />
</LinearLayout>
