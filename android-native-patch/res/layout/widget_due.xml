<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/due_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_due_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/due_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="Jatuh tempo"
        android:textColor="@color/rfw_text_dim"
        android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/due_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/due_name_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/rfw_text"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/due_when_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_text_dim"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/due_when_hot_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_hot"
                android:textSize="10sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/due_amount_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_text"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/due_amount_good_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_good"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/due_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/due_name_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/rfw_text"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/due_when_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_text_dim"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/due_when_hot_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_hot"
                android:textSize="10sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/due_amount_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_text"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/due_amount_good_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_good"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/due_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/due_name_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/rfw_text"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/due_when_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_text_dim"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/due_when_hot_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_hot"
                android:textSize="10sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/due_amount_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_text"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/due_amount_good_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_good"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/due_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/due_name_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/rfw_text"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/due_when_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_text_dim"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/due_when_hot_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_hot"
                android:textSize="10sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/due_amount_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_text"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/due_amount_good_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/rfw_good"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />
        </LinearLayout>

    <TextView
        android:id="@+id/due_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Tidak ada tagihan atau hutang jatuh tempo dalam 7 hari."
        android:textColor="@color/rfw_good"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/due_insight_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/due_insight_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rfw_text"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/due_insight_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rfw_text_dim"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
